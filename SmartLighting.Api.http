@SmartLighting.Api_HostAddress = http://localhost:5282
@DeviceId = A0000000-0000-0000-0000-000000000001
@ProjectId = B0000000-0000-0000-0000-000000000001
@ZoneId = C0000000-0000-0000-0000-000000000001

GET {{SmartLighting.Api_HostAddress}}/ping
Accept: application/json

###

GET {{SmartLighting.Api_HostAddress}}/devices
Accept: application/json

###

GET {{SmartLighting.Api_HostAddress}}/devices/{{DeviceId}}
Accept: application/json

###

# Inclua todos os slots já cadastrados; omitir um deles retorna erro.
PUT {{SmartLighting.Api_HostAddress}}/devices/{{DeviceId}}
Content-Type: application/json

{
  "name": "ESP32 1 atualizado",
  "sensors": [
    {
      "slot": 1,
      "name": "Sensor 1",
      "zoneId": "{{ZoneId}}"
    }
  ],
  "luminaires": [
    {
      "slot": 1,
      "name": "LED 1",
      "zoneIds": ["{{ZoneId}}"],
      "nominalPowerWatts": 10
    }
  ]
}

###

GET {{SmartLighting.Api_HostAddress}}/devices/{{DeviceId}}/topology
Accept: application/json

###

GET {{SmartLighting.Api_HostAddress}}/projects
Accept: application/json

###

GET {{SmartLighting.Api_HostAddress}}/projects/{{ProjectId}}/dashboard
Accept: application/json

###

POST {{SmartLighting.Api_HostAddress}}/projects/{{ProjectId}}/devices
Content-Type: application/json

{
  "name": "ESP32 1",
  "sensors": [
    {
      "slot": 1,
      "name": "Sensor 1",
      "zoneId": "{{ZoneId}}"
    }
  ],
  "luminaires": [
    {
      "slot": 1,
      "name": "LED 1",
      "zoneIds": ["{{ZoneId}}"],
      "nominalPowerWatts": 10
    }
  ]
}

###

POST {{SmartLighting.Api_HostAddress}}/devices/{{DeviceId}}/telemetry
Content-Type: application/json

{
  "sentAtUtc": "2026-10-03T12:00:00Z",
  "sensorEvents": [],
  "luminaireStateChanges": []
}

###
